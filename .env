# Non-secret project defaults. Machine-specific overrides belong in .env.local.
# Optional import directory; unset uses the repository-owned git-sources.json.
TEAMAGENT_GIT_SOURCES_DIR=
TEAMAGENT_GIT_CACHE=.cache/git
TEAMAGENT_GIT_AUTO_STASH=true
# m means calendar months, d means days.
TEAMAGENT_GIT_OUTDATED_THRESHOLD=4m
TEAMAGENT_GIT_OUTDATED_PREFIX=xx-<YYMM>-
TEAMAGENT_GIT_REMOVED_PREFIX=zz-<YYMM>-
# Empty resolves the authenticated GitHub account when a private backup is needed.
TEAMAGENT_GIT_BACKUP_ACCOUNT=
TEAMAGENT_REPOMIX_CACHE=.cache/git.repomix
TEAMAGENT_TEXT_CACHE=.cache/text
