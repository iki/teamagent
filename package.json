{
  "name": "teamagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./memory": "./lib/memory/index.ts",
    "./memory/bun": "./app/runtime/memory.ts",
    "./integrations": "./lib/integrations/index.ts",
    "./integrations/bun": "./app/integrations/index.ts",
    "./media": "./lib/media/index.ts",
    "./media/bun": "./app/media/index.ts",
    "./channels": "./lib/channels/index.ts",
    "./channels/bun": "./app/channels/index.ts",
    "./project-launcher": "./app/check/project-launcher.ts"
  },
  "scripts": {
    "task:run": "bun app/workflow/index.ts",
    "project:run": "bun app/check/project-launch.ts",
    "deps": "bun app/dependencies/index.ts",
    "deps:check": "bun app/dependencies/index.ts check",
    "cache:status": "bun app/check/cache.ts status",
    "cache:verify-staged": "bun app/check/cache.ts verify-staged",
    "typecheck": "bun app/check/typecheck.ts",
    "dev": "bun app/cli/index.ts harness serve",
    "cli": "bun app/cli/index.ts",
    "imports:setup": "bun app/cli/index.ts memory setup",
    "benchmark:memory": "bun app/benchmark/index.ts",
    "benchmark:extractors": "bun app/benchmark/extractors.ts",
    "benchmark:repomix": "bun app/research/repomix-benchmark.ts",
    "build:web": "bun app/web/build.ts",
    "build:desktop": "bun app/desktop/build.ts build",
    "test:web": "bun app/check/integration.ts web",
    "test:desktop": "bun app/check/integration.ts desktop",
    "lint": "bun app/check/tool.ts lint --type-aware --deny-warnings",
    "format": "bun app/check/tool.ts format",
    "format:check": "bun app/check/tool.ts format --check",
    "test": "bun test --timeout 120000",
    "check": "bun app/check/index.ts",
    "step:check": "bun app/check/index.ts --format",
    "review:check": "bun app/check/index.ts",
    "conversations:record": "bun app/conversations/record.ts",
    "hooks:install": "bun app/hooks/install.ts",
    "sources:sync": "bun app/research/index.ts sources",
    "repos:sync": "bun app/research/index.ts repos",
    "repos:status": "bun app/research/index.ts status",
    "repos:observe": "bun app/research/index.ts observe",
    "analysis:sync": "bun app/research/index.ts analysis",
    "resources:sync": "bun app/research/index.ts texts",
    "research:sync": "bun app/research/index.ts sync"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@logtape/logtape": "2.4.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tauri-apps/api": "2.12.4",
    "c12": "4.0.0-rc.2",
    "cleye": "2.7.0",
    "consola": "3.4.2",
    "effect": "4.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "effect-oxlint": "0.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite": "8.3.5"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "aube@2.5.1",
  "aube": {
    "patchedDependencies": {
      "tinypool@2.2.0": "patches/trigon/tinypool@2.2.0.patch"
    }
  }
}
