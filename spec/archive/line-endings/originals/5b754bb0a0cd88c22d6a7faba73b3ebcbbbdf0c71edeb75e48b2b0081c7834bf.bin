    "id": "ai-agents-mem--turbovec",
    "category": "ai-agents-mem",
    "name": "turbovec",
    "github": "https://github.com/RyanCodrai/turbovec",
    "revision": "c6cf0baba11ddc0b0ec7f95d4024d816df3bd8ec",
    "commit_date": "2026-10-02T19:48:43+01:00",
    "file_count": 868,
