  {
    "id": "ai-agents-mem--xx-2604-memento",
    "category": "ai-agents-mem",
    "name": "xx-2604-memento",
    "github": "https://github.com/microsoft/memento",
    "revision": "d8c10e66ff313844b4b5f063dd4c075d3ea56aab",
    "commit_date": "2026-04-08T19:51:52-04:00",
    "file_count": 81,
    "readme": "README.md",
    "manifests": [
      "data/requirements.txt"
    ],
    "license_files": [
      "LICENSE"
    ],
    "license_hint": "MIT",
    "topics": [
      "memory",
      "evolution"
    ],
    "report": "projects/ai-agents-mem--xx-2604-memento.md",
    "screening_excerpt": "Memento** extends the effective output length of large language models by splitting chain-of-thought reasoning into **blocks** and **summaries** (memento). After each reasoning block, the model generates a short summary, then the block content is evicted from the KV cache. The model continues from the summary with a shorter context, enabling more reasoning within a fixed context window. See vllm/README.md for full documentation, including API usage and alternative setup options."
  },
  {
    "id": "ai-agents-mem--xx-2604-mgp.memory-governance-protocol",
    "category": "ai-agents-mem",
    "name": "xx-2604-mgp.memory-governance-protocol",
    "github": "https://github.com/HKUDS/MGP",
    "revision": "54ce6c00e3d0aa731ecbe17e74407cbbb5a96f10",
    "commit_date": "2026-04-25T16:35:25+08:00",
    "file_count": 309,
    "readme": "README.md",
    "manifests": [
      "compliance/requirements.txt",
      "docs/requirements.txt",
      "pyproject.toml",
      "reference/requirements.txt",
      "sdk/python/pyproject.toml"
    ],
    "license_files": [
      "LICENSE"
    ],
    "license_hint": "MIT",
    "topics": [
      "memory",
      "evolution"
    ],
    "report": "projects/ai-agents-mem--xx-2604-mgp.memory-governance-protocol.md",
    "screening_excerpt": "MGP standardizes how AI runtimes **write, recall, govern, and audit persistent memory** across heterogeneous backends. Think of it as a unified contract layer — your agent talks to one protocol, and any compliant memory backend just works. MCP** standardizes *tools and resources*. **MGP** standardizes *governed memory*. They are peer protocols — complementary, not competing."
  },
  {
