  {
    "id": "ai-query--fastmcp",
    "category": "ai-query",
    "name": "fastmcp",
    "github": "https://github.com/punkpeye/fastmcp",
    "revision": "3cc03cfea6ca74dd5b0c004de498a3083e8f2348",
