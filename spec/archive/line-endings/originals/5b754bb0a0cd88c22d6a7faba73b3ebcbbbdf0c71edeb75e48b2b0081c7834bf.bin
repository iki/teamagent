  {
    "id": "ai-agents-mem--code-review-graph",
    "category": "ai-agents-mem",
    "name": "code-review-graph",
    "github": "https://github.com/tirth8205/code-review-graph",
    "revision": "343ab7cea29d47a3e805381e09f8243a43d43d88",
    "commit_date": "2026-09-18T20:40:44+01:00",
    "file_count": 470,
