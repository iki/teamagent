  {
    "id": "ai-skills--agent-codex",
    "topics": [
      "skills",
      "agents",
      "import-generation"
    ],
    "depth": "source-reviewed",
    "summary": "Use the upstream catalog as a curated candidate source and its installer as an optional native integration for the corresponding host. Avoid copying the whole catalog into every prompt or rewriting an existing installation without a rollback path. Wrap acquisition with byte/file limits and source lock records. Evaluate a small selected set per target model and harness, especially tool-specific media and document workflows whose execution environments differ substantially.",
    "word_count": 336
