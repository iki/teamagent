  {
    "id": "ai-prompts--xx-2604-agent-opt",
    "category": "ai-prompts",
    "name": "xx-2604-agent-opt",
    "github": "https://github.com/future-agi/agent-opt",
    "revision": "b28657e8b5407edebea32da9ab47211033816884",
    "commit_date": "2026-04-27T16:22:23+05:30",
    "report": "projects/ai-prompts--xx-2604-agent-opt.md",
    "depth": "source-reviewed",
    "topics": [
      "evolution",
      "skills",
      "models",
      "decisions"
    ],
    "summary": "Use as an optional offline optimizer adapter, alongside simpler random search and the separately reviewed DSPy/GEPA approach. Restrict the initial search space to description wording, examples, tool-order policy, and context budget. Require reproducible input hashes, explicit trials budget, and comparison against no-skill and upstream-skill baselines. Promote a winner only after independent validation and a small canary; a higher optimizer score alone must not rewrite the active team library."
  },
