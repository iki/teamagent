  {
    "id": "ai-agents-skills--create.skill-seekers",
    "category": "ai-agents-skills",
    "name": "create.skill-seekers",
    "github": "https://github.com/yusufkaraaslan/Skill_Seekers",
    "revision": "5b5d8dfca263fa76e6daae9f292890b311ef36aa",
    "commit_date": "2026-09-30T21:49:15+03:00",
    "report": "projects/ai-agents-skills--create.skill-seekers.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "import-generation",
      "memory",
      "evolution"
    ],
    "summary": "Use as a candidate importer worker and a source of adapter patterns, initially for a small verified subset such as repository, HTML, and PDF. Run extraction in a restricted process with byte/time limits. Compare resulting text and provenance against fixtures before expanding formats. Keep conflict preservation mandatory when AI-assisted merging proposes a convenient single answer, and never execute imported scripts during discovery."
  },
  {
    "id": "ai-agents-skills--docs.2603.skills-discovery-rfc.cloudflare",
    "category": "ai-agents-skills",
    "name": "docs.2603.skills-discovery-rfc.cloudflare",
    "github": "https://github.com/cloudflare/agent-skills-discovery-rfc",
    "revision": "1bd1167983fa5ac9cd47987710c525308eda1a98",
    "commit_date": "2026-03-24T16:59:23-04:00",
    "report": "projects/ai-agents-skills--docs.2603.skills-discovery-rfc.cloudflare.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "import-generation"
    ],
    "summary": "Implement as an optional discovery provider behind a versioned schema adapter. Support only explicitly understood versions, display unsupported entries as unavailable, and keep a Git/manual import fallback. The first release should register metadata and download to quarantine; activation remains a separate lifecycle step. Test stale indexes, digest mismatches, cross-origin URLs, malicious paths, oversized archives, and interrupted downloads before enabling unattended refresh."
  },
  {
    "id": "ai-agents-skills--docs.skills",
    "category": "ai-agents-skills",
    "name": "docs.skills",
    "github": "https://github.com/agentskills/agentskills",
    "revision": "69ef37e9424c0a7ea9dd2293b559e43ec8176379",
    "commit_date": "2026-08-09T13:36:04-07:00",
    "report": "projects/ai-agents-skills--docs.skills.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "evolution"
    ],
    "summary": "Adopt as the canonical interoperability format and baseline authoring protocol. Require positive and near-miss negative trigger fixtures plus paired outcome evaluation for tuned skills. Store evaluation artifacts beside a versioned skill manifest, with model, harness, tool set, seed where applicable, and costs. Extend metadata through namespaced fields and preserve original upstream files so a harness-specific variant remains traceable to its source."
  },
  {
    "id": "ai-agents-skills--evolve-claude.autoharness",
    "category": "ai-agents-skills",
    "name": "evolve-claude.autoharness",
    "github": "https://github.com/tigerless-labs/autoharness",
    "revision": "6bf36182dcdb95a55bc8fd8b522ce845f855cbc6",
    "commit_date": "2026-10-02T17:43:38+08:00",
    "report": "projects/ai-agents-skills--evolve-claude.autoharness.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "evolution",
      "memory",
      "decisions"
    ],
    "summary": "Adopt the lifecycle architecture selectively; do not enable automatic global self-modification as the default. Replace placeholder thresholds with workload measurements. Use a durable single-writer service or transactional store and idempotent proposal IDs. A candidate must pass independent evaluation before canary activation; subsequent regressions restore the previous digest. Retain infrequently used emergency procedures under an explicit protected policy."
  },
  {
    "id": "ai-agents-skills--manage.skillware",
    "category": "ai-agents-skills",
    "name": "manage.skillware",
    "github": "https://github.com/ARPAHLS/skillware",
    "revision": "2d59fadc583b67071c47a7e0870bfaf9f95431b8",
    "commit_date": "2026-10-02T19:00:24+03:00",
    "report": "projects/ai-agents-skills--manage.skillware.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "import-generation",
      "agents"
    ],
    "summary": "Use individual bundles only after dependency, license, and behavior review, and borrow the inspect-only API for the internal registry. Do not directly import arbitrary discovered skills into the orchestrator process. Execute implementations in restricted workers with explicit tool scopes, isolated dependencies, and a typed result schema. Escalate manifest/path identity disagreement to a registration error for managed team libraries, while allowing explicit aliases recorded as metadata."
  },
