  {
    "id": "ai-spec--get-shit-done",
    "category": "ai-spec",
    "name": "get-shit-done",
    "github": "https://github.com/gsd-build/get-shit-done",
    "revision": "bdcaab2c752d9a33a1a1ca9acf3a3c81fb991815",
    "commit_date": "2026-05-31T08:34:35-05:00",
    "report": "projects/ai-spec--get-shit-done.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "agents",
      "evolution",
      "memory"
    ],
    "summary": "Curate the wave-planning and compact-coordinator techniques into a coding workflow bundle. Implement completion reconciliation in deterministic runtime code, using run IDs and explicit verifiers. Permit sequential fallback when the host cannot reliably spawn or report workers. Measure whether extra planning and verification agents improve task success enough to justify latency and cost. Keep context references small and durable, and avoid treating a large role catalog as a reason to spawn every role for every task."
  },
  {
    "id": "ai-spec--openspec",
    "category": "ai-spec",
    "name": "openspec",
    "github": "https://github.com/Fission-AI/OpenSpec",
    "revision": "2500d6da971336167548b53731a35b2127df35ac",
    "commit_date": "2026-10-02T17:34:46Z",
    "report": "projects/ai-spec--openspec.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "evolution",
      "agents",
      "memory"
    ],
    "summary": "Adopt the schema-driven artifact graph pattern and provide an OpenSpec integration for teams already using it. Keep durable execution, cancellation, retries, and permissions in the harness engine. Treat the graph's deterministic order as a reproducibility aid, not a quality guarantee. Evaluate partial completion, changed prerequisites, interrupted transitions, and concurrent workers. Use its spec/change artifacts as queryable project memory, retaining both the current accepted state and historical decisions that explain why it changed."
  },
  {
    "id": "ai-spec--openspec-vscode",
