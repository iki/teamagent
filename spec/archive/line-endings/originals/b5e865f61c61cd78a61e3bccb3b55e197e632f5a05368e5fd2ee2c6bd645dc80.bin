  {
    "id": "ai-prompts--prompts.chat",
    "category": "ai-prompts",
    "name": "prompts.chat",
    "github": "https://github.com/f/prompts.chat",
    "revision": "7d3f248962d1dca209d59e033524bcb86c2b26b8",
    "commit_date": "2026-10-01T12:56:12+03:00",
    "report": "projects/ai-prompts--prompts.chat.md",
    "depth": "source-reviewed",
    "topics": [
      "skills",
      "import-generation",
      "evolution"
    ],
    "summary": "Integrate as an optional search/import source, not as a trusted skill registry or optimizer. Convert selected prompts into versioned candidates with explicit input/output contracts and test examples. Use media recipes only through the generation-tool registry and its model capability checks. Preserve the original prompt separately from tuned variants and compare against a concise baseline. Add near-miss trigger tests before promoting any general prompt into an automatically selected skill."
  },
