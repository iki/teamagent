  {
    "id": "ai-agents-tokens--ccusage",
    "category": "ai-agents-tokens",
    "name": "ccusage",
    "github": "https://github.com/ryoppippi/ccusage",
    "revision": "7b9e09b09f8015cf082f191cbcc7739a44c699ff",
    "commit_date": "2026-10-03T20:01:22Z",
    "report": "projects/ai-agents-tokens--ccusage.md",
    "depth": "source-reviewed",
    "topics": [
      "evolution",
      "models",
      "agents",
      "decisions"
    ],
    "summary": "Use ccusage as an optional local accounting adapter or cross-check, with read-only access to explicitly selected session logs. Prefer first-party structured usage events where available. Keep monetary estimates, subscription entitlement status, and observed resource use as separate fields. Add golden log fixtures for forks, compaction, model switches, partial writes, and unknown models. Unknown accounting must remain unknown rather than becoming zero in dashboards or routing decisions."
  },
  {
    "id": "ai-agents-tokens--claude-powerline",
