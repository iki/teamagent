  {
    "id": "ai-info--rearchitecting-llms",
    "category": "ai-info",
    "name": "rearchitecting-llms",
    "github": "https://github.com/peremartra/Rearchitecting-LLMs",
    "revision": "fa7027b6be9f68e8689dd0d561735a72f347eb33",
    "commit_date": "2026-10-01T17:55:13+02:00",
    "report": "projects/ai-info--rearchitecting-llms.md",
    "depth": "source-reviewed",
    "topics": [
      "models",
      "evolution",
      "decisions"
    ],
    "summary": "Keep as a research reference for a later specialized-local-model program. Separate calibration, recovery, training, validation, and held-out task data. Record the original model, license, transformation recipe, hardware, precision, and model artifact hash. Require integration-level evaluation of the resulting model with its intended skills and tools before routing production tasks to it. Do not make pruning or fine-tuning a prerequisite for the initial local/cloud harness, and do not treat educational notebook outputs as independently validated benchmarks."
  },
