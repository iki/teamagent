  {
    "id": "ai-eval--xx-2602-ragas",
    "category": "ai-eval",
    "name": "xx-2602-ragas",
    "github": "https://github.com/vibrantlabsai/ragas",
    "revision": "298b68274234c060deacab3cf5fb52aa3a20e885",
    "commit_date": "2026-02-24T13:17:18+05:30",
    "report": "projects/ai-eval--xx-2602-ragas.md",
    "depth": "source-reviewed",
    "topics": [
      "evolution",
      "memory",
      "decisions"
    ],
    "summary": "Adopt selected metrics behind the evaluation protocol for knowledge-query tasks, after calibrating them on the team's domain. Prefer deterministic verifiers for compilation, tests, tool effects, and citation existence. Keep faithfulness as one dimension in a scorecard instead of collapsing it into a universal quality score. Treat NaN and evaluator errors as unknown with explicit coverage statistics. Re-evaluate when the retrieval pipeline, source parser, or judge changes, not only when the answering model changes."
  },
