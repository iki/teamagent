    "category": "ai-agents-tokens",
    "name": "codeburn",
    "github": "https://github.com/getagentseal/codeburn",
    "revision": "aded4c232622b82284f22d172cecb137354e3071",
    "commit_date": "2026-10-02T16:43:15+02:00",
    "report": "projects/ai-agents-tokens--codeburn.md",
    "depth": "source-reviewed",
    "topics": [
      "evolution",
      "models",
      "skills",
      "agents",
      "decisions"
    ],
    "summary": "Evaluate as an optional usage dashboard/importer and a provider-parser reference, especially for mixed installed agents. Keep raw transcript access local by default and export only the necessary normalized fields. Calibrate inferred skill use against explicit events in controlled traces. Use its telemetry to identify candidates for optimization, then verify benefit through matched task evaluation. Do not equate activity counts with productivity or transform imperfect historical log parsing into a hard billing authority."
  },
